{
  // Cloudflare Workers: `npm run build`, then `wrangler deploy`.
  // The site is static assets; worker/index.js runs only for the Parquet files
  // to answer HTTP range requests, which the assets layer ignores.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burn-calendar",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*.parquet"]
  }
}
